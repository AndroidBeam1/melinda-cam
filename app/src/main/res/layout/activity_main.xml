<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Melinda Cam"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thingino Wyze Cam v3 — free, no ads, no Cam Plus."
            android:textSize="16sp" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            app:show_buffering="when_playing" />

        <WebView
            android:id="@+id/mjpegView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/petPhotoView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:scaleType="centerCrop"
            android:contentDescription="Photo caught by Pet Watch" />

        <Button
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="▶  PLAY LIVE"
            android:textSize="24sp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="STOP"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Not connected yet. Go to Setup and type your camera IP and password once."
            android:textSize="16sp" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="TEST CONNECTION"
            android:textSize="20sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="RETRY PLAY"
            android:textSize="20sp" />

        <Button
            android:id="@+id/snapshotButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="SHOW SNAPSHOT"
            android:textSize="20sp" />

        <Button
            android:id="@+id/mjpegButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="VIEW WITH MJPEG"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Motion + Pet + Sound"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Where is my pet?"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pet Watch — motion photo, not 100% dog AI yet. When it sees movement it takes a photo and shows it here."
            android:textSize="16sp" />

        <Button
            android:id="@+id/motionButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="MOTION ALERTS: OFF — TAP TO TURN ON" />

        <Button
            android:id="@+id/petButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="PET WATCH: OFF — TAP TO TURN ON" />

        <Button
            android:id="@+id/soundButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="SOUND: ON — TAP TO MUTE" />

        <Button
            android:id="@+id/talkButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:text="🎤 TALK — MICROPHONE"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Talk is experimental in v2: it turns your phone mic on and records your voice. Talking through the camera speaker is a work in progress, not promised yet."
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Home / Away"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/homeButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="HOME — Jamesport Wi-Fi" />

        <Button
            android:id="@+id/awayButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="AWAY — Cameron, mom's hotspot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Away only works with Tailscale through your home computer. Your computer in Jamesport stays on, runs Tailscale, and is the bridge to the camera. Your phone in Cameron runs Tailscale too and talks through that computer. Away uses the same camera IP, 10.40.1.114, through Tailscale — not a 100.x address."
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Stream"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stream1080Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="1080p — ch0" />

        <Button
            android:id="@+id/stream360Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="360p — ch1" />

        <Button
            android:id="@+id/copyRtspButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="COPY RTSP LINK" />

        <TextView
            android:id="@+id/rtspText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="RTSP is for this Android app and VLC. Browsers cannot play RTSP, so the web view uses MJPEG."
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Setup — do this once"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Camera IP at home — 10.40.1.114"
            android:inputType="text" />

        <EditText
            android:id="@+id/remoteHostInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Away address — same camera IP, 10.40.1.114, via Tailscale"
            android:inputType="text" />

        <EditText
            android:id="@+id/usernameInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Stream username — usually thingino"
            android:inputType="text" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Camera password (root) — the one you set in Thingino"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/streamPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Stream password — for live video, usually thingino"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Two passwords: Camera password is for photos and Test Connection. Stream password is for live video (Play) — usually thingino, the Thingino default."
            android:textSize="16sp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:text="SAVE SETTINGS"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Recordings — SD card"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No camera connected yet. Connect the camera in Setup first, then recordings from the SD card will show here. Tap a recording to see it, Download to save it to your phone, Share to send it to your device."
            android:textSize="16sp" />

        <Button
            android:id="@+id/openRecordingsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="OPEN RECORDINGS IN BROWSER" />

        <Button
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="SHARE CAMERA LINK" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cloud — save your photos"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. TERRABOX — MAIN storage, 1 TB free — use this first"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1 TB free storage. Your own TerraBox account. Use this first."
            android:textSize="16sp" />

        <Button
            android:id="@+id/teraboxButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="OPEN TERRABOX" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. MEGA — next, 20 GB free — use this when TerraBox runs out"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your own Mega account, 20 GB free. Use this when TerraBox runs out."
            android:textSize="16sp" />

        <Button
            android:id="@+id/megaButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="OPEN MEGA" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. GOOGLE DRIVE — next, 15 GB free — use this when Mega runs out"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your own Google account, 15 GB free. Not your mom's Drive. Use this when Mega runs out."
            android:textSize="16sp" />

        <Button
            android:id="@+id/driveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="OPEN MY GOOGLE DRIVE" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="4. COMPUTER CLOUD — COMING SOON, only about 5 GB — use this last, only if it is set up"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your own cloud on your home computer in Jamesport. Coming soon — not built yet. Only about 5 GB. Use this last, only if it is set up."
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Use them in this order: TerraBox first, then Mega, then Google Drive, then Computer Cloud last. The app does not automatically move files between them yet — you pick which one to upload to, in that order."
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="AI Helper — in the app, not a real person"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/helperInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Ask about motion, night vision, RTSP, recording..."
            android:inputType="text" />

        <Button
            android:id="@+id/askButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="ASK HELPER" />

        <TextView
            android:id="@+id/helperAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Try: How do I turn on motion?"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Customize"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pick a theme color, make buttons BIG or HUGE, switch Dark / Light, or hit PARTY! Camera LED and IR only work when the camera is connected."
            android:textSize="16sp" />

        <Button
            android:id="@+id/themePink"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="PINK" />

        <Button
            android:id="@+id/themeTeal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="TEAL" />

        <Button
            android:id="@+id/themePurple"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="PURPLE" />

        <Button
            android:id="@+id/themeBlue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="BLUE" />

        <Button
            android:id="@+id/themeOrange"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="ORANGE" />

        <Button
            android:id="@+id/themeGreen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="GREEN" />

        <Button
            android:id="@+id/sizeButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="BUTTON SIZE: BIG — TAP FOR HUGE" />

        <Button
            android:id="@+id/darkButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="LIGHT MODE: ON — TAP FOR DARK" />

        <Button
            android:id="@+id/partyButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:text="🎉 PARTY!"
            android:textSize="20sp" />

        <Button
            android:id="@+id/ledButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="CAMERA LED: ON — TAP TO TURN OFF" />

        <Button
            android:id="@+id/nightButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="NIGHT MODE: AUTO" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Roku — coming soon"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your Roku app is a separate build coming soon. This app does not control your Roku yet in v2. Your earlier Roku work was MelindaHome — a custom home and screensaver for Roku."
            android:textSize="16sp" />

        <Button
            android:id="@+id/rokuButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="OPEN ROKU APP INFO" />

    </LinearLayout>
</ScrollView>
